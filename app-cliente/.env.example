# Firebase — MISMO proyecto que la clínica web. Copia los valores de las
# variables NEXT_PUBLIC_FIREBASE_* que ya tienes en Vercel / .env.local.
# En Expo, las variables públicas del cliente llevan prefijo EXPO_PUBLIC_.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend de la clínica (Vercel) — para el pago con Stripe.
# Ej: https://clinica-gold-omega.vercel.app
EXPO_PUBLIC_API_URL=
