# ─── Firebase (cliente / navegador) ──────────────────────────────────────────
# Salen del objeto firebaseConfig en Firebase Console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Apuntar la app a los emuladores locales (1 en dev con emuladores, vacío/0 en prod).
NEXT_PUBLIC_USE_EMULATORS=

# ─── Firebase Admin SDK (servidor) ───────────────────────────────────────────
# Salen del JSON de service account: Project settings → Service accounts →
# Generate new private key. La private key va con los \n LITERALES (sin saltos
# de línea reales); lib/firebase/admin.ts los convierte en runtime.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Resend (envío de correos al paciente) ───────────────────────────────────
# API key de https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado. En pruebas puedes usar el dominio de prueba de Resend
# (onboarding@resend.dev). En producción: algo@legalmind.com.mx (dominio verificado).
EMAIL_FROM="ClinicaApp <onboarding@resend.dev>"

# ─── Cron (recordatorios de cita) ────────────────────────────────────────────
# Secreto compartido que protege /api/cron/reminders. Genera uno aleatorio largo.
CRON_SECRET=

# URL pública de la app (para enlaces dentro de los correos, si hicieran falta).
NEXT_PUBLIC_APP_URL=http://localhost:3000
