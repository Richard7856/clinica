rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de rol (staff) ──────────────────────────────────────────────
    // El rol se propaga a custom claims al crear/editar el doc de staff desde
    // el admin (server action), así queda accesible en el ID token.
    function isSignedIn() {
      return request.auth != null;
    }
    function email() {
      return request.auth.token.email;
    }
    function role() {
      return request.auth.token.role;
    }
    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }
    function isReception() {
      return isSignedIn() && role() == 'reception';
    }
    function isTherapist() {
      return isSignedIn() && role() == 'therapist';
    }
    function isCollaborator() {
      return isSignedIn() && role() == 'collaborator';
    }
    function isStaff() {
      return isAdmin() || isReception() || isTherapist() || isCollaborator();
    }

    // ── Helpers de cliente (app móvil) ──────────────────────────────────────
    // Los clientes NO son staff. Se ligan a su ficha por el correo del token.
    // OJO (demo): permitir que el cliente escriba su propio doc/puntos es una
    // simplificación para la demostración. En producción, otorgar/descontar
    // puntos debería pasar por un backend de confianza (server action/Function).
    function ownsPatientDoc() {
      return isSignedIn() && resource.data.email == email();
    }
    function ownsPatient(pid) {
      return isSignedIn()
        && get(/databases/$(database)/documents/patients/$(pid)).data.email == email();
    }

    // ── Pacientes ───────────────────────────────────────────────────────────
    match /patients/{patientId} {
      // Staff ve todo; el cliente ve solo su propia ficha (match por correo).
      allow read: if isStaff() || ownsPatientDoc();

      // El cliente crea su ficha al registrarse, con saldo en cero y sin
      // privilegios. Antes solo la clínica podía crearla, así que quien se
      // registraba desde la app quedaba sin ficha y no podía ni agendar.
      allow create: if isAdmin() || isReception()
                    || (isSignedIn()
                        && request.resource.data.email == email()
                        && request.resource.data.points == 0
                        && request.resource.data.banned == false
                        && request.resource.data.storeEnabled == false);

      // El cliente solo edita sus datos de contacto. `points`, `banned`,
      // `storeEnabled` y el propio correo son de la clínica: mientras esto
      // fue un `allow update` abierto, cualquiera podía asignarse Cisnes
      // desde su teléfono.
      allow update: if isAdmin() || isReception()
                    // El colaborador asigna Cisnes al escanear el QR de una
                    // visita: eso escribe en la ficha. Solo puede mover el
                    // saldo, no bloquear ni dar acceso a la tienda.
                    || (isStaff()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['points', 'updatedAt']))
                    || (ownsPatientDoc()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['fullName', 'phone', 'updatedAt']));
      allow delete: if isAdmin();

      match /history/{entryId} {
        allow read: if isStaff();
        allow create: if isStaff();
        allow update, delete: if isAdmin();
      }
    }

    // ── Catálogos internos (solo staff) ─────────────────────────────────────
    match /treatments/{id}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /cabins/{id}      { allow read: if isStaff(); allow write: if isAdmin(); }
    // Aparatos: staff los administra (cambiar estado desde la app admin).
    match /devices/{id}     { allow read: if isStaff(); allow write: if isStaff(); }

    match /packages/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isReception();
      allow delete: if isAdmin();
    }

    match /sessions/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /appointments/{id} {
      allow read: if isStaff() || ownsPatient(resource.data.patientId);
      allow create: if isAdmin() || isReception()
                    || ownsPatient(request.resource.data.patientId);
      // Marcar la visita y asignar Cisnes es del staff, no del cliente.
      allow update: if isStaff();
      allow delete: if isAdmin() || isReception();
    }

    match /checkins/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Sucursales: las lee cualquier autenticado (el cliente elige sede al
    // agendar y las ve en Ubicación); solo el admin las administra.
    match /clinics/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Catálogos públicos de la app cliente ────────────────────────────────
    // Cualquier usuario autenticado los lee; solo el staff los administra.
    match /promotions/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /rewardItems/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /products/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /storeProducts/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ── Pagos: financiero, solo staff lee. El cliente puede CREAR su propio
    // pago (compra desde la app). ───────────────────────────────────────────
    match /payments/{id} {
      allow read: if isAdmin() || isReception();
      allow create: if isAdmin() || isReception()
                    || ownsPatient(request.resource.data.patientId);
      allow update: if isAdmin() || isReception();
      allow delete: if isAdmin();
    }

    // ── Movimientos de puntos: el cliente lee/crea los suyos ─────────────────
    match /rewards/{id} {
      allow read: if isStaff() || ownsPatient(resource.data.patientId);
      // Los movimientos de Cisnes los escribe la clínica: al escanear el QR
      // de una visita o al entregar un canje. El cliente solo los lee.
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ── Canjes: el cliente crea el suyo; el staff lo marca como honrado ──────
    match /redemptions/{id} {
      allow read: if isStaff() || ownsPatient(resource.data.patientId);
      // El cliente aparta su canje, pero nace "pendiente" y con el costo REAL
      // del catálogo: si pudiera escribir el costo, se llevaría gratis lo caro.
      // Los Cisnes se descuentan cuando la clínica lo entrega, no al pedirlo.
      allow create: if isStaff()
                    || (ownsPatient(request.resource.data.patientId)
                        && request.resource.data.status == 'pending'
                        && request.resource.data.cost ==
                           get(/databases/$(database)/documents/rewardItems/$(request.resource.data.rewardItemId)).data.cost);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Staff ────────────────────────────────────────────────────────────────
    match /staff/{uid} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Settings: cualquier autenticado lee (nombre, horarios, pointsRate);
    // solo admin escribe. ────────────────────────────────────────────────────
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Solo Admin SDK (webhook idempotencia): denegado a clientes.
    match /stripeEvents/{id} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
